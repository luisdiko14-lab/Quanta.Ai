{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://quanta-ai-api.onrender.com/api/:path*"
    },
    {
      "source": "/health/:path*",
      "destination": "https://quanta-ai-api.onrender.com/health/:path*"
    }
  ]
}
